    { "q": "How is a minter's allowance set?", "expect": ["FiatTokenV1.configureMinter", "FiatTokenV1.minterAllowance"] },
    { "q": "Who controls the minters?", "expect": ["FiatTokenV1.onlyMasterMinter", "FiatTokenV1.updateMasterMinter", "FiatTokenV1.configureMinter", "FiatTokenV1.removeMinter"] },

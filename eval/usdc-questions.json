    { "q": "Who is the proxy admin and can it be changed?", "expect": ["AdminUpgradeabilityProxy.changeAdmin", "AdminUpgradeabilityProxy.admin", "AdminUpgradeabilityProxy.ifAdmin", "AdminUpgradeabilityProxy._setAdmin"] },
    { "q": "Can transfers be paused?", "expect": ["Pausable.pause", "Pausable.whenNotPaused", "FiatTokenV1.transfer"] },
    { "q": "Who is allowed to pause the contract?", "expect": ["Pausable.onlyPauser", "Pausable.pause", "Pausable.updatePauser"] },
    { "q": "Can tokens sent to the contract by mistake be recovered?", "expect": ["Rescuable.rescueERC20"] },
    { "q": "Who can burn USDC?", "expect": ["FiatTokenV1.burn"] },
    { "q": "How is ownership of the token contract transferred?", "expect": ["Ownable.transferOwnership", "Ownable.setOwner"] },
    { "q": "How do gasless transfers with a signed authorization work?", "expect": ["FiatTokenV2.transferWithAuthorization", "FiatTokenV2_2.transferWithAuthorization", "EIP3009._transferWithAuthorization"] },
    { "q": "How does permit (EIP-2612) approval work?", "expect": ["FiatTokenV2.permit", "FiatTokenV2_2.permit", "EIP2612._permit"] },
    { "q": "How are the blacklist flag and balance stored together?", "expect": ["FiatTokenV2_2._setBlacklistState", "FiatTokenV2_2._setBalance", "FiatTokenV2_2._isBlacklisted", "FiatTokenV2_2._balanceOf"] }
  ]

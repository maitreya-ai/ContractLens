# Copy to .env.local and fill in what you need. Everything is optional except
# ANTHROPIC_API_KEY, which enables written answers and risk reports.
# Without it, ContractLens runs in retrieval-only mode (search + detectors).

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_EFFORT=medium          # low | medium | high | xhigh | max
# REPORT_EFFORT=high
# ANTHROPIC_FALLBACKS=default # server-side refusal fallback; set to "off" to disable

# --- Database -----------------------------------------------------------------
# Leave empty to use the embedded PGlite database in .data/pglite.
# Or point at any Postgres with pgvector (Supabase, Neon, RDS, docker compose):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/contractlens
# PGLITE_DIR=.data/pglite

# --- Contract sources ---------------------------------------------------------
# Sourcify is used first and needs no key. An Etherscan V2 key (one key covers
# 50+ chains) adds a fallback for contracts only verified on Etherscan.
# ETHERSCAN_API_KEY=

# --- Retrieval ----------------------------------------------------------------
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5   # must output 384 dimensions
# MODEL_CACHE_DIR=.data/models
# CHAT_TOP_K=8
